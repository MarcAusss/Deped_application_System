<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
</IfModule>

# This folder is now the web server's document root, sitting next to
# .env, vendor/, storage/, composer.json/.lock, and .git/ — none of those
# are meant to be reachable by URL. Block them explicitly rather than
# relying on them just not being linked to.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^composer\.(json|lock)$">
    Require all denied
</FilesMatch>

RewriteRule ^(vendor|storage)(/|$) - [F,L]
